# ==============================================================================
# KRISHIDHENU PRODUCTION ENVIRONMENT VARIABLES
# Add these in your Railway service -> Variables tab
# ==============================================================================

# Core Node Environment
NODE_ENV=production

# Railway Nixpacks Node Runtime (Forces Node 22 for native node:sqlite support)
NIXPACKS_NODE_VERSION=22

# Unified Persistent SQLite Database Location
# Mount Railway Persistent Volume at /app/data and set this exact variable:
DATABASE_PATH=/app/data/dev.db

# Security & Authentication (Required: Generate 64-char random strings for production)
JWT_SECRET=replace_with_64_character_random_secret_string_here
OTP_SECRET=replace_with_another_64_character_random_salt_string_here

# OTP Mode: "true" allows instant demo login; set "false" only when SMS provider is connected
OTP_DEMO_MODE=true

# SMS Gateway Provider: "dev" (simulated), "msg91", "twilio", or "exotel"
SMS_PROVIDER=dev

# Optional: MSG91 Credentials (Only required if SMS_PROVIDER=msg91 and OTP_DEMO_MODE=false)
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=

# Optional: Twilio Credentials (Only required if SMS_PROVIDER=twilio and OTP_DEMO_MODE=false)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_VERIFY_SERVICE_SID=

# Note: DO NOT manually set PORT. Railway automatically injects PORT dynamically.
